# =========================================================
# DOPOSoccer 2026-2 - .gitignore
# =========================================================

# ---------- Archivo de estudio personal (NUNCA se sube) ----------
EXPLICACION_CODIGO.txt
PLAN_VERSION1_DOPOSoccer.txt

# ---------- Compilados de Java ----------
*.class
bin/
out/
target/
build/
*.jar
*.war
*.ear
# Excepcion: las librerias del proyecto (JUnit) SI se versionan
!lib/*.jar

# Logs de errores de la JVM
hs_err_pid*
replay_pid*
*.log
dopo_errors.log

# ---------- Archivos que generan otros IDE (el proyecto usa solo VS Code) ----------
.project
.classpath
.metadata/
.settings/
.factorypath
*.launch

# ---------- Temporales ----------
tmp/
*.tmp
*.bak
*.swp

# ---------- VS Code ----------
# Se versiona solo la configuracion compartida del proyecto
# (carpetas de codigo, JUnit, clase principal y extension recomendada).
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.DopoSoccer/

# ---------- IntelliJ (por si algun companero lo abre) ----------
.idea/
*.iml

# ---------- Sistema operativo ----------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

SUSTENTACION_DOPOSoccer.md

# Persistencia (archivos que crea el juego)
dopo_progress.dat
*.dopo

# Comprimidos y copias (no se suben: duplican lo que ya esta en el repo)
*.zip

# ---------- Claude Code (configuracion local de agentes, NUNCA se sube) ----------
.claude/
CLAUDE.md
CLAUDE.local.md
